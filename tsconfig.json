{
  "compilerOptions": {
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowJs": true,
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    // keep pre-TS5 class-field semantics; the telescope-generated contract
    // clients redeclare base-class fields and babel compiles them accordingly
    "useDefineForClassFields": false,
    "lib": ["es2022", "dom"],
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*", "__tests__/**/*"],
  "exclude": ["node_modules"]
}
