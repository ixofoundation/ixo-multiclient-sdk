# Local dev overrides for `wrangler dev`. Copy to `.dev.vars`.
# No signing key is ever needed: this server is non-custodial.

# Network: mainnet | testnet | devnet (default: mainnet)
IXO_NETWORK=mainnet

# Optional overrides (otherwise derived from the network preset)
# IXO_RPC_URL=https://impacthub.ixo.world/rpc/
# IXO_CHAIN_ID=ixo-5
# IXO_GAS_PRICE=0.025uixo

# OPTIONAL endpoint auth token. When set, every /mcp and /sse request must send
# `Authorization: Bearer <token>` (or `X-API-Key: <token>`). REQUIRED to enable
# server-signing. In production use `wrangler secret put IXO_MCP_AUTH_TOKEN`.
# IXO_MCP_AUTH_TOKEN="a-long-random-secret"

# OPTIONAL custodial server-signing mode. When set, the ixo_server_* tools
# become available and the SERVER signs with this wallet. Requires
# IXO_MCP_AUTH_TOKEN to also be set (otherwise the tools stay disabled). Leave
# unset for the default non-custodial flow. Use `wrangler secret put IXO_MNEMONIC`.
# IXO_MNEMONIC="word1 word2 ... word24"
